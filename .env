GEMINI_API_KEY = ""
DEEPSEEK_API_KEY = ""

# --- LOCAL MODEL CONFIGURATION ---
# Base API URL for local model server (e.g. Ollama, LM Studio, vLLM)
LOCAL_API_BASE=http://localhost:11434/v1
# Name of the local model to run
LOCAL_MODEL=qwen2.5
# Local API Key (use "local" if not required by your server)
LOCAL_API_KEY=local

# --- OLLAMA CHUNKED MODEL CONFIGURATION ---
# Set LLM_PROVIDER=ollama to use OllamaChunkedModel (token-aware splitting).
# Falls back to LOCAL_* values if OLLAMA_* vars are not set.
# OLLAMA_API_BASE=http://localhost:11434/v1
# OLLAMA_MODEL=qwen2.5
# OLLAMA_API_KEY=local
# Soft limit: if prompt tokens exceed this, split into multiple calls (default 35000)
# OLLAMA_SOFT_TOKEN_LIMIT=35000
# Hard limit: absolute max tokens per call (default 50000)
# OLLAMA_HARD_TOKEN_LIMIT=50000
